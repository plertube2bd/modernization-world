{
  "schemaVersion": 1,
  "id": "modernization_world",
  "version": "${version}",
  "name": "Modernization World",
  "description": "Analog redstone computing, electric circuits, oil and petrochemistry, firearms, diesel cars built from blocks, self-driving rail transport, 220 V factories, moving structures, a redcoat raid and the BOSS Mode bosses in one mod.",
  "license": "All Rights Reserved",
  "icon": "assets/modernization_world/icon.png",
  "contact": {
    "sources": "https://github.com/plertube2bd/analogAlu"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.analogalu.AnalogAlu",
      "com.example.redstonetransportation.RedstoneTransportation",
      "com.example.modernizationworld.ModernizationWorld",
      "com.bossmode.BossMode"
    ],
    "client": [
      "com.example.analogalu.WaferEditorClient",
      "com.example.redstonetransportation.client.RedstoneTransportationClient",
      "com.bossmode.client.BossModeClient"
    ]
  },
  "mixins": [
    "analog_alu.mixins.json",
    "redstone_transportation.mixins.json",
    "boss_mode.mixins.json",
    {
      "config": "boss_mode.client.mixins.json",
      "environment": "client"
    }
  ],
  "provides": [
    "analog_alu",
    "redstone_transportation",
    "boss_mode"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.3 <26.4",
    "java": ">=25",
    "fabric-api": "*",
    "geckolib": ">=5.5.7"
  }
}
